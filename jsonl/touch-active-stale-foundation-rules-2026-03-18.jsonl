{"type":"prohibition","rule_id":"TOUCH_MUST_NOT_BE_IMPLICIT_FROM_NON_TOUCH_ACTIONS","description":"System must not create touch facts from card creation, edit, move, hover, or other non-touch actions.","entities":["card","touch_fact","touch_action"],"priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#8"}
{"type":"prohibition","rule_id":"HIDDEN_CARDS_MUST_NOT_BE_CLASSIFIED_ACTIVE_OR_STALE","description":"Hidden cards are excluded from active/stale classification.","entities":["card","visibility","active_state","stale_state"],"priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#5"}
{"type":"prohibition","rule_id":"KEYBOARD_SHORTCUTS_MUST_NOT_BE_ENABLED_IN_THIS_FEATURE","description":"Touch and stale-lens keyboard shortcuts must not be shipped in this feature scope.","entities":["keyboard_shortcut","touch_action","stale_lens"],"priority":"P1","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#2"}
{"type":"boundary","rule_id":"ONE_EFFECTIVE_TOUCH_PER_CARD_PER_LOCAL_DAY","description":"At most one effective touch fact may exist per card for a given runtime-local calendar day.","entities":["card","touch_fact","local_day"],"condition":"same card_id and same local_day","priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#3"}
{"type":"boundary","rule_id":"TOUCH_UNDO_WINDOW_IS_SIX_SECONDS","description":"Undo for a newly created touch fact is valid only within 6 seconds of touch creation.","entities":["touch_action","undo_action","touch_fact"],"condition":"elapsed_time_since_touch <= 6 seconds","priority":"P1","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#3.5"}
{"type":"boundary","rule_id":"CENTER_ACTIVE_SEVEN_DAY_COUNT_THRESHOLD_IS_THREE","description":"Center card qualifies as active when seven-day touch count is 3 or more.","entities":["card","placement","touch_count_7d","active_state"],"condition":"placement=center AND touch_count_7d >= 3","priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#5"}
{"type":"boundary","rule_id":"PERIPHERY_ACTIVE_SEVEN_DAY_COUNT_THRESHOLD_IS_TWO","description":"Periphery card qualifies as active when seven-day touch count is 2 or more.","entities":["card","placement","touch_count_7d","active_state"],"condition":"placement=periphery AND touch_count_7d >= 2","priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#5"}
{"type":"state_transition","rule_id":"FIRST_TOUCH_OF_LOCAL_DAY_CREATES_TOUCH_FACT","description":"If no touch fact exists for card/local_day, touch action creates one fact and sets touched-today icon ON.","entities":["card","touch_action","touch_fact","touch_icon"],"condition":"no existing touch_fact for (card_id, local_day)","priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#3"}
{"type":"state_transition","rule_id":"REPEATED_SAME_DAY_TOUCH_IS_NO_OP","description":"If touch fact already exists for card/local_day, repeated touch action is semantic no-op.","entities":["card","touch_action","touch_fact"],"condition":"existing touch_fact for (card_id, local_day)","priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#3.2"}
{"type":"state_transition","rule_id":"UNDO_WITHIN_WINDOW_REMOVES_JUST_CREATED_TOUCH_FACT","description":"Undo action within six-second window removes the touch fact created by the immediately preceding touch action.","entities":["undo_action","touch_fact","touch_action"],"condition":"undo targets most recent touch_action AND elapsed_time <= 6s","priority":"P1","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#3.5"}
{"type":"state_transition","rule_id":"CENTER_TO_PERIPHERY_MOVE_RECOMPUTES_ACTIVE_STALE_IMMEDIATELY","description":"Moving card from center to periphery triggers immediate derivation using periphery thresholds.","entities":["card","placement","active_state","stale_state"],"priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#6"}
{"type":"state_transition","rule_id":"PERIPHERY_TO_CENTER_MOVE_RECOMPUTES_ACTIVE_STALE_IMMEDIATELY","description":"Moving card from periphery to center triggers immediate derivation using center thresholds.","entities":["card","placement","active_state","stale_state"],"priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#6"}
{"type":"validation","rule_id":"TOUCH_FACT_DAY_MUST_USE_RUNTIME_LOCAL_TIMEZONE","description":"Touch fact local_day must be computed using user local timezone at runtime.","entities":["touch_fact","local_day","timezone"],"priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#3.4"}
{"type":"validation","rule_id":"NEW_CARD_CREATION_MUST_NOT_CREATE_TOUCH_FACT","description":"Card creation event must not produce a touch fact unless explicit touch action occurs.","entities":["card","card_creation","touch_fact"],"priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#3.3"}
{"type":"invariant","rule_id":"DAILY_TOUCH_FACTS_ARE_SOURCE_OF_TRUTH","description":"Active/stale correctness must be reproducible from daily touch facts plus placement and runtime-local date.","entities":["touch_fact","placement","active_state","stale_state"],"priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#4"}
{"type":"invariant","rule_id":"HIDE_RECOVER_PRESERVES_TOUCH_HISTORY","description":"Hide and recover transitions must preserve prior touch facts without mutation.","entities":["card","visibility","touch_fact"],"priority":"P1","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#4.3"}
{"type":"business_rule","rule_id":"CENTER_ACTIVE_IF_RECENT_TOUCH_OR_SEVEN_DAY_CONTINUITY","description":"Center card is active when touched within last 2 days OR seven-day touch count is at least 3; otherwise stale.","entities":["card","placement","touch_recency_days","touch_count_7d","active_state","stale_state"],"priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#5"}
{"type":"business_rule","rule_id":"PERIPHERY_ACTIVE_IF_RECENT_TOUCH_OR_SEVEN_DAY_CONTINUITY","description":"Periphery card is active when touched within last 4 days OR seven-day touch count is at least 2; otherwise stale.","entities":["card","placement","touch_recency_days","touch_count_7d","active_state","stale_state"],"priority":"P0","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#5"}
{"type":"relationship","rule_id":"TOUCHED_TODAY_ICON_REFLECTS_FACT_FOR_CARD_AND_LOCAL_DAY","description":"Touch icon ON state must map to existence of touch fact for that card and current local_day; OFF otherwise.","entities":["touch_icon","card","touch_fact","local_day"],"priority":"P1","feature":"touch-active-stale-foundation","source_ref":"spec/feature-touch-active-stale-foundation-2026-03-18.md#7"}
{"type":"example","rule_id":"EXAMPLE_SAME_DAY_REPEAT_TOUCH_FAILS_TO_CREATE_SECOND_FACT","description":"Second touch on same day is rejected as semantic duplicate.","entities":["card","touch_fact","touch_action"],"example_pass":{"pre":{"card_id":"c1","facts":[]},"action":{"touch":true,"local_day":"2026-03-18"},"post":{"facts":[{"card_id":"c1","local_day":"2026-03-18"}]}},"example_fail":{"pre":{"card_id":"c1","facts":[{"card_id":"c1","local_day":"2026-03-18"}]},"action":{"touch":true,"local_day":"2026-03-18"},"post_invalid":{"facts":[{"card_id":"c1","local_day":"2026-03-18"},{"card_id":"c1","local_day":"2026-03-18"}]}} ,"priority":"P1","feature":"touch-active-stale-foundation"}
{"type":"example","rule_id":"EXAMPLE_PLACEMENT_MOVE_CAN_FLIP_ACTIVE_TO_STALE","description":"Same touch history can be active in periphery but stale in center due to stricter center thresholds.","entities":["card","placement","touch_count_7d","active_state","stale_state"],"example_pass":{"pre":{"placement":"periphery","touch_count_7d":2,"touched_within_days":3},"post":{"state":"active"},"move":{"to":"center"},"post_after_move":{"state":"stale"}},"example_fail":{"post_invalid":{"state_after_move":"active"}},"priority":"P1","feature":"touch-active-stale-foundation"}
