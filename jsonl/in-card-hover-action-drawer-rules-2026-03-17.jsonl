{"type":"invariant","rule_id":"SLIPPING_GLYPH_REMAINS_UNCHANGED","description":"The existing slipping glyph must remain unchanged in behavior and placement.","entities":["card","slipping_glyph"],"priority":"P1","feature":"in-card-hover-action-drawer","source_ref":"spec/feature-in-card-hover-action-drawer-2026-03-17.md#In Scope"}
{"type":"state_transition","rule_id":"CARD_DRAWER_TRANSITION_HIDDEN_TO_VISIBLE_ON_HOVER","description":"When pointer enters the top-right hover zone on desktop, drawer transitions from hidden to visible.","entities":["card","action_drawer","pointer"],"condition":"Desktop/web hover context","priority":"P1","feature":"in-card-hover-action-drawer","source_ref":"spec/feature-in-card-hover-action-drawer-2026-03-17.md#Core User Flow"}
{"type":"state_transition","rule_id":"CARD_DRAWER_TRANSITION_VISIBLE_TO_HIDDEN_ON_HOVER_LEAVE","description":"When pointer leaves the drawer/action zone, drawer transitions from visible to hidden.","entities":["card","action_drawer","pointer"],"condition":"No active pointer within action zone","priority":"P1","feature":"in-card-hover-action-drawer","source_ref":"spec/feature-in-card-hover-action-drawer-2026-03-17.md#Core User Flow"}
{"type":"invariant","rule_id":"DRAWER_OPEN_REQUIRES_UNDERLAY_DIMMING","description":"Whenever the drawer is visible, content under the drawer region is slightly dimmed for foreground separation.","entities":["action_drawer","card_content"],"priority":"P1","feature":"in-card-hover-action-drawer","source_ref":"spec/feature-in-card-hover-action-drawer-2026-03-17.md#In Scope"}
