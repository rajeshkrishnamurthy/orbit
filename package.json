{
  "name": "orbit-ui-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright UI tests for Orbit",
  "scripts": {
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:mutation": "go run github.com/avito-tech/go-mutesting/cmd/go-mutesting@latest --exec-timeout 20 .",
    "test:mutation:html": "go run github.com/avito-tech/go-mutesting/cmd/go-mutesting@latest --html-output --exec-timeout 20 ."
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0"
  }
}
